{
  "name": "cf-cliproxy",
  "description": "cliproxy running full time free on cf",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "ops": "node scripts/ops.ts",
    "types": "wrangler types --include-env=false",
    "typecheck": "tsc && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "lint": "eslint .",
    "build": "node scripts/fetch-panel.mjs",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.12.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.4",
    "wrangler": "4.149.0"
  },
  "cloudflare": {
    "bindings": {
      "MANAGEMENT_KEY": {
        "description": "The existing CLIProxyAPI management key, at least 16 characters."
      },
      "ANTIGRAVITY_CLIENT_SECRET": {
        "description": "The upstream desktop OAuth client secret, supplied privately."
      }
    }
  },
  "dependencies": {
    "yaml": "2.8.1"
  }
}
