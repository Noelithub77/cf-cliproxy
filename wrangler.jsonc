{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "infer-cf",
  "account_id": "75bb6d35925d6493575a3e2d6deac186",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "infer-cf.allpyq.in", "custom_domain": true }],
  "observability": { "enabled": true, "head_sampling_rate": 0.01 },
  "limits": { "cpu_ms": 10 },
  "build": { "command": "node scripts/fetch-panel.mjs" },
  "assets": { "directory": "public", "binding": "ASSETS", "run_worker_first": true, "html_handling": "none" },
  "durable_objects": { "bindings": [{ "name": "STORE", "class_name": "Store" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Store"] }]
}
